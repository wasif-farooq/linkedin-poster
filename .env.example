# --- LLM (OpenCode Zen) ---
# Read from your shell env (e.g. exported in ~/.bashrc) or set here.
OPEN_CODE_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Default model for every agent; override per role below if one works better.
DEFAULT_MODEL=space-bunny-free
# MANAGER_MODEL=
# TOPIC_SCOUT_MODEL=
# RESEARCHER_MODEL=
# WRITER_MODEL=
# CRITIC_MODEL=
# ILLUSTRATOR_MODEL=           # writes the image prompt
# Tried in order if a model is removed or blocked (free "stealth" models rotate).
# Only space-bunny-free works via the API on the free tier today (2026-09-24);
# add paid Zen models here if you want a safety net, e.g. LLM_FALLBACK_MODELS=kimi-k2,glm-4.6
LLM_FALLBACK_MODELS=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=120

# --- Free-tier protection ---
LLM_MAX_TOKENS=16000           # cap per call; reasoning ("thinking") tokens count toward it
LLM_REQUESTS_PER_MINUTE=20     # client-side limiter shared by all agents
LLM_RATE_LIMIT_RETRIES=3       # extra retries on HTTP 429...
LLM_RATE_LIMIT_BACKOFF=10      # ...waiting 10s, 20s, 40s (or the server's Retry-After)
MAX_LLM_CALLS_PER_RUN=30       # hard budget per run/chat turn
STRUCTURED_RETRIES=2
# auto = try native function calling then fall back to JSON parsing; json = JSON parsing only
STRUCTURED_MODE=auto

# --- Research (free web search via ddgs, no API key) ---
SEARCH_PROVIDER=ddgs
SEARCH_RESULTS_PER_QUERY=5
MAX_SEARCHES_PER_RUN=6         # live queries per run; cached repeats are free
SEARCH_CACHE_HOURS=24
SEARCH_MIN_INTERVAL=2          # seconds between live queries
SEARCH_RETRIES=2
SEARCH_BACKOFF=5               # seconds, doubled per retry
MAX_ARTICLES_PER_RUN=6         # full pages read per research
ARTICLE_MAX_CHARS=3000

# --- Writing ---
POST_TARGET_MIN_CHARS=700
POST_TARGET_MAX_CHARS=1800
CRITIC_MIN_SCORE=7             # any critic score below this -> revise
# VOICE_PATH=config/voice.md   # your tone/style guide for the Writer

# --- LinkedIn (Phase 6) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
LINKEDIN_VERSION=202609        # YYYYMM API version; LinkedIn retires versions after ~1 year
PUBLISH_MODE=share             # share = "Share on LinkedIn" link (no LinkedIn app needed) · api = post via the API
PUBLISH_DRY_RUN=false          # api mode: true = record the post locally instead of publishing

# --- Images (on request) ---
# auto = OpenAI when OPENAI_API_KEY is set, otherwise Pollinations.ai (free, no key,
# unofficial, small watermark, can be slow). openai = gpt-image-1, about $0.04 per image.
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium    # low | medium | high | auto
IMAGE_TIMEOUT=180
MAX_IMAGES_PER_RUN=3

# --- Limits ---
MAX_REVISIONS=2
MAX_STEPS_PER_TURN=12
